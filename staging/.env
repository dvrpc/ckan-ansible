VMS="ckan"               # name/hostname of each virtual machine you want to create
OS="ubuntu24.04"   # operating systems corresponding to each vm in VMS
SIZE="25"                # storage size of each vm in GBs
MEMORY="4"                # memory of each vm in GBs
VCPU="2"                  # number of VCPUs for each vm
IP="192.168.110.1"         # starting IP address. Each vm after the first will be +1.
NETWORK="ckan_staging"   # name of network
CONNECTION="qemu:///system" # virtualization emulator
USER_NAME="dev"      # user to login with
SSH_PUB_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINhnGDmkslQ+X1JDW2HIwsLBvRI0SP+YV8zrppQiGDgW 2026"    # use ssh-keygen to create keys and put content of public key (not filename) here
